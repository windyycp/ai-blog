# 复制为 .env.docker 后按需修改（该文件已被 .gitignore 忽略，不会进版本库）

# 镜像仓库
REGISTRY=registry.cn-shenzhen.aliyuncs.com
NAMESPACE=ycp
TAG=latest

# docker login 使用；脚本通过 --password-stdin 传入，不会落到命令行历史
REGISTRY_USER=ycpaly
REGISTRY_PASSWORD=

# 站点对外地址：canonical / sitemap / RSS / CORS 都用它
SITE_URL=http://localhost:3000
WEB_PORT=3000

# 数据库：compose 不启动数据库容器，直连已有 PostgreSQL 14+
# PG 跑在宿主机上就用 host.docker.internal；跑在别的机器上换成其内网/公网地址
DB_DRIVER=postgres
DATABASE_URL=postgres://blog:blog-change-me@host.docker.internal:5432/blog
PG_POOL_MAX=10

# 想改用 SQLite（单机小站）时改为下面两行，并把 DATABASE_URL 留空：
# DB_DRIVER=sqlite
# SQLITE_PATH=/app/data/blog.db
# ALLOW_SQLITE_IN_PROD=true

# 按需失效接口的共享密钥，务必改成随机串
REVALIDATE_SECRET=dev-revalidate-secret
